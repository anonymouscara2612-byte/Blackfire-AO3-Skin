  padding-bottom: 22px;
}

.splash .favorite::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-30%);
  width: 90px;
  height: 90px;
  background-image: url("https://64.media.tumblr.com/ded7266a041ad1a7b93daa3928c5802c/db557fb1e5b36e99-9d/s500x750/32e481d7b2e2a38c93041cf600256a4d1e56beae.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: "ℑ 𝔞𝔩𝔴𝔞𝔶𝔰 𝔴𝔞𝔰 𝔱𝔥𝔢 𝔟𝔢𝔱𝔱𝔢𝔯 𝔣𝔦𝔤𝔥𝔱𝔢𝔯";
