  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(20px);
  border-radius: 10px;
  background: rgba(8, 7, 12, 0.7);
  text-align: center;
  font-size: 14px;
  color: #E9C9E0;
  opacity: 1;
  white-space: pre;
}

